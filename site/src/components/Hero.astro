---
// The home page's first screen: what org-os is, who the page is for, and what
// to do next — two links, and the commands an operator runs most. The commands
// come from src/data/landing.yaml, each with the place it is run, printed in
// words above it. test/command-where.test.mjs holds each one to that place: a
// command shown for an instance must be in what an instance receives.
import Button from "./Button.astro";
import { withBase } from "../lib/base";
import { WHERE } from "../../scripts/command-where.mjs";
interface Cta { label: string; href: string; variant: "solid" | "ghost"; }
interface Command { run: string; where: keyof typeof WHERE; does: string; doc: string; }
interface Props { label: string; title: string; subtitle: string; ctas: Cta[]; commands: Command[]; commandsTitle: string; }
const { label, title, subtitle, ctas, commands, commandsTitle } = Astro.props;
---
<header class="hero">
  <div class="say">
    <p class="eyebrow">{label}</p>
    <h1 class="headline">{title}</h1>
    <p class="lead sub">{subtitle}</p>
    <div class="ctas">{ctas.map((c) => <Button href={c.href} variant={c.variant}>{c.label}</Button>)}</div>
  </div>
  <section class="surface panel" aria-labelledby="hero-commands">
    <h2 class="label" id="hero-commands">{commandsTitle}</h2>
    <ul>
      {commands.map((c) => (
        <li>
          <a class="row" href={withBase(c.doc)}>
            <span class="where label">{WHERE[c.where]}</span>
            <code class="run">{c.run}</code>
            <span class="does">{c.does}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</header>
<style>
.hero {
  display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--space-12);
  align-items: end; padding-block: var(--space-16) var(--space-12);
  border-bottom: var(--border-hair) solid var(--color-line-2);
}
.headline { font-size: var(--text-display); line-height: var(--leading-display); margin-top: var(--space-4); max-width: 14ch; }
.sub { margin-top: var(--space-5); max-width: 46ch; }
.ctas { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }

.panel { padding: var(--space-4) var(--space-5) var(--space-2); background: var(--color-surface-2); }
.panel h2 { font-weight: 500; letter-spacing: var(--tracking-wide); }
.panel ul { list-style: none; padding: 0; margin-top: var(--space-2); }
.panel li + li { border-top: var(--border-hair) solid var(--color-line); }
.row { display: grid; row-gap: var(--space-1); padding-block: var(--space-3); color: inherit; }
.run { overflow-wrap: anywhere; font-size: var(--text-sm); color: var(--color-ink); font-weight: 500; transition: color var(--t-fast); }
.does { font-size: var(--text-sm); color: var(--color-muted); line-height: var(--leading-snug); }
.row:hover .run { color: var(--color-accent); }

@media (max-width: 860px) {
  .hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); padding-block: var(--space-10) var(--space-8); }
}
</style>
