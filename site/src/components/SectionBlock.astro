---
// One block of a page: a ruled head (number, title, a link out) and its content.
interface Props { title: string; href?: string; cta?: string; index?: string; }
const { title, href, cta, index } = Astro.props;
---
<section class="block">
  <div class="head">
    <h2>{index && <span class="idx" aria-hidden="true">{index}</span>}{title}</h2>
    {href && cta && <a href={href} class="cta mono link">{cta}</a>}
  </div>
  <slot />
</section>
<style>
.block { margin-top: var(--space-16); }
.head {
  display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-6);
  border-bottom: var(--border-hair) solid var(--color-line-2);
  padding-bottom: var(--space-3); margin-bottom: var(--space-6);
}
.head h2 { font-size: var(--text-lg); }
.idx { color: var(--color-muted); font-weight: 400; margin-right: var(--space-3); font-variant-numeric: tabular-nums; }
.cta { font-size: var(--text-sm); white-space: nowrap; }
</style>
