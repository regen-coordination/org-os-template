---
// Drift: slow motes of light behind the page — the quiet living background of
// a console's system menu, turned down. One small canvas; it stops when the
// tab is hidden and stands still under reduced motion.
---
<canvas class="drift" aria-hidden="true"></canvas>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".drift");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const motes = Array.from({ length: 34 }, (_, i) => ({
      x: Math.random(), y: Math.random(),
      r: 1.2 + Math.random() * 3.2,
      vx: (Math.random() - 0.5) * 0.00006, vy: -(0.00002 + Math.random() * 0.00007),
      hue: i % 3, phase: Math.random() * Math.PI * 2,
    }));
    let colours = ["", "", ""];
    const readColours = () => {
      const css = getComputedStyle(document.documentElement);
      colours = ["--aura-1", "--color-glow", "--aura-3"].map((name) => css.getPropertyValue(name).trim());
    };
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(window.innerWidth * dpr);
      canvas.height = Math.round(window.innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    let last = 0;
    const draw = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      const w = window.innerWidth, h = window.innerHeight;
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        if (!still) {
          m.x += m.vx * dt; m.y += m.vy * dt;
          if (m.y < -0.05) { m.y = 1.05; m.x = Math.random(); }
          if (m.x < -0.05) m.x = 1.05; else if (m.x > 1.05) m.x = -0.05;
        }
        const pulse = 0.55 + 0.45 * Math.sin(m.phase + now * 0.0006);
        // smaller on a narrow screen; fainter on light paper, where a mote reads as a smudge
        const x = m.x * w, y = m.y * h, r = m.r * (w < 700 ? 2.2 : 4);
        const glow = ctx.createRadialGradient(x, y, 0, x, y, r);
        glow.addColorStop(0, colours[m.hue]);
        glow.addColorStop(1, "transparent");
        ctx.globalAlpha = pulse * (document.documentElement.dataset.theme === "dark" ? 1 : 0.3);
        ctx.fillStyle = glow;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!still && !document.hidden) frame = requestAnimationFrame(draw);
    };
    let frame = 0;
    const start = () => { cancelAnimationFrame(frame); last = 0; frame = requestAnimationFrame(draw); };
    readColours(); size(); start();
    window.addEventListener("resize", () => { size(); start(); });
    document.addEventListener("visibilitychange", () => { if (!document.hidden) start(); });
    // The theme switch changes the palette: read it again.
    new MutationObserver(() => { readColours(); start(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>
<style>
.drift { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
@media print { .drift { display: none; } }
</style>
