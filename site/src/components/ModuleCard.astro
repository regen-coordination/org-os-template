---
import StatusBadge from "./StatusBadge.astro";
interface Props { id: string; name: string; status: "planned" | "in-dev" | "live"; summary: string; link: string | null; }
const { id, name, status, summary, link } = Astro.props;
---
<article class:list={["surface card ticked", status]} data-status={status}>
  <header class="head">
    <span class="id mono">{id}</span>
    <StatusBadge status={status} />
  </header>
  <h3 class="name">{name}</h3>
  <p class="summary">{summary}</p>
  {link
    ? <a class="more mono link" href={link}>learn more<span class="arr"> →</span></a>
    : <span class="more mono muted">spec pending</span>}
</article>
<style>
.card {
  position: relative; overflow: hidden;
  padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3);
  box-shadow: var(--shadow-1);
  transition: transform var(--t-fast), box-shadow var(--t-fast), border-color var(--t-fast);
}
/* status accent rail along the top edge */
.card::after {
  content: ""; position: absolute; inset: 0 0 auto 0; height: 2px;
  background: var(--color-line-2);
}
.card.live::after, .card.in-dev::after { background: var(--color-accent); }
.card:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); border-color: var(--color-line-2); }

.head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); }
.id { font-size: var(--text-2xs); letter-spacing: var(--tracking-wide); color: var(--color-faint); }
.name { margin: 0; }
.summary { margin: 0; font-size: var(--text-sm); color: var(--color-muted); line-height: var(--leading-snug); flex: 1; }
.more { font-size: var(--text-sm); color: var(--color-accent); margin-top: var(--space-1); }
.more.muted { color: var(--color-faint); }
.more .arr { display: inline-block; transition: transform var(--t-fast); }
.more:hover .arr { transform: translateX(3px); }
</style>
