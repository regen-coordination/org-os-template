---
// One registered instance: its name, its type and its link. Nothing else from
// data/instances.yaml is printed; scripts/verify-build.mjs holds this line to
// instanceLine() in scripts/registry-leaks.mjs.
import type { FederationNode } from "../lib/federation";
import { REPOSITORY_LABEL } from "../../scripts/registry-leaks.mjs";
interface Props { node: FederationNode; }
const { node } = Astro.props;
---
<li class="instance" data-instance>
  <span class="name">{node.name}</span>
  <span class="label type">{node.type}</span>
  {node.repo && <a class="repo mono link" href={node.repo}>{REPOSITORY_LABEL}</a>}
</li>
<style>
.instance {
  display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: baseline;
  gap: var(--space-4); padding-block: var(--space-3);
  border-bottom: var(--border-hair) solid var(--color-line);
}
.name { color: var(--color-ink); font-weight: 500; }
.type { color: var(--color-muted); }
.repo { font-size: var(--text-sm); color: var(--color-accent); min-width: 6rem; text-align: right; }
</style>
