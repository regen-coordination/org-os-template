---
import { withBase } from "../lib/base";
import { VERSION, REPO_URL } from "../lib/repo.mjs";
const year = 2026; // build-stamped
---
<footer class="footer">
  <div class="container-wide footer-inner">
    <div class="col about">
      <span class="brand mono">~/org-os</span>
      <p class="tag">The agent-native operating system for organizations: a framework, its standards, and the hub of a federation.</p>
    </div>
    <nav class="col links mono" aria-label="Site">
      <span class="label">Site</span>
      <a class="link" href={withBase("/docs")}>Docs</a>
      <a class="link" href={withBase("/modules")}>Modules</a>
      <a class="link" href={withBase("/federation")}>Federation</a>
      <a class="link" href={REPO_URL}>Source</a>
    </nav>
    <nav class="col links mono" aria-label="Machine-readable">
      <span class="label">Machine</span>
      <a class="link" href={withBase("/llms.txt")}>llms.txt</a>
      <a class="link" href={withBase("/federation.json")}>federation.json</a>
      <a class="link" href={withBase("/.well-known/dao.json")}>.well-known/dao.json</a>
    </nav>
  </div>
  <div class="container-wide baseline mono">
    <span>MIT · {year}</span>
    <span>v{VERSION} · pre-beta</span>
  </div>
</footer>
<style>
.footer { margin-top: var(--space-16); border-top: var(--border-hair) solid var(--color-line-2); background: var(--color-bg-2); }
.footer-inner { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: var(--space-8); padding-block: var(--space-8) var(--space-6); }
.brand { font-weight: 600; color: var(--color-ink); font-size: var(--text-sm); }
.tag { margin-top: var(--space-2); max-width: 44ch; font-size: var(--text-sm); color: var(--color-muted); line-height: var(--leading-snug); }
.col.links { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); font-size: var(--text-sm); }
.col .label { margin-bottom: var(--space-1); }
.col .link { color: var(--color-ink-2); }
.baseline { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2);
  padding-block: var(--space-4); border-top: var(--border-hair) solid var(--color-line);
  font-size: var(--text-2xs); letter-spacing: var(--tracking-wide); color: var(--color-muted); text-transform: uppercase; }
@media (max-width: 720px) { .footer-inner { grid-template-columns: 1fr 1fr; } .footer-inner .about { grid-column: 1 / -1; } }
</style>
