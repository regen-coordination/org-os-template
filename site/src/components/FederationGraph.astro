---
import type { Federation } from "../lib/federation";
interface Props { federation: Federation; }
const { federation } = Astro.props;

const W = 760, H = 560, cx = W / 2, cy = H / 2;
const rx = 288, ry = 194;

const nodes = federation.nodes;
const pos = new Map<string, { x: number; y: number }>();
pos.set(federation.root.id, { x: cx, y: cy });
nodes.forEach((n, i) => {
  const a = (i / nodes.length) * Math.PI * 2 - Math.PI / 2;
  pos.set(n.id, { x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry });
});

// Quadratic curve bowed gently toward the center — gives the schematic an orbital feel.
function curve(from: string, to: string) {
  const a = pos.get(from), b = pos.get(to);
  if (!a || !b) return null;
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
  const ctlx = mx + (cx - mx) * 0.16, ctly = my + (cy - my) * 0.16;
  return `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} Q ${ctlx.toFixed(1)} ${ctly.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
}

// Radially-splayed labels so they fan outward instead of colliding.
function label(id: string) {
  const p = pos.get(id)!;
  const ang = Math.atan2(p.y - cy, p.x - cx);
  return {
    x: (p.x + Math.cos(ang) * 14).toFixed(1),
    y: (p.y + Math.sin(ang) * 14 + 4).toFixed(1),
    anchor: Math.cos(ang) >= -0.15 ? "start" : "end",
  };
}
---
<figure class="fed-figure figure">
  <svg class="fed-graph" viewBox={`0 0 ${W} ${H}`} role="img"
       aria-label="org-os federation network — instances orbiting the framework root, connected by framework and federation links">
    <title>org-os federation network</title>

    <!-- orbit guide -->
    <ellipse cx={cx} cy={cy} rx={rx} ry={ry} class="orbit" />

    <!-- edges -->
    {federation.edges.map((e) => {
      const d = curve(e.from, e.to);
      return d ? <path d={d} class:list={["fed-edge", e.kind]} /> : null;
    })}

    <!-- non-root nodes -->
    {nodes.map((n, i) => {
      const p = pos.get(n.id)!;
      const l = label(n.id);
      return (
        <g class="node">
          {n.available && <circle cx={p.x} cy={p.y} r="8" class="halo" style={`animation-delay:${(i * 0.32).toFixed(2)}s`} />}
          <circle cx={p.x} cy={p.y} r="5.5" class:list={["dot", n.available ? "live" : "offline"]} />
          <text x={l.x} y={l.y} text-anchor={l.anchor} class="fed-label">{n.id}</text>
        </g>
      );
    })}

    <!-- root -->
    <g class="root">
      <circle cx={cx} cy={cy} r="17" class="root-ring" />
      <circle cx={cx} cy={cy} r="9.5" class="root-core" />
      <circle cx={cx} cy={cy} r="3" class="root-pip" />
      <text x={cx} y={cy + 34} text-anchor="middle" class="fed-label root-label">org-os</text>
    </g>

    <!-- legend -->
    <g class="legend" transform={`translate(20 ${H - 58})`}>
      <line x1="0" y1="0" x2="22" y2="0" class="fed-edge framework" />
      <text x="30" y="4" class="leg">framework lineage</text>
      <line x1="0" y1="18" x2="22" y2="18" class="fed-edge federation" />
      <text x="30" y="22" class="leg">federation link</text>
      <circle cx="11" cy="36" r="4.5" class="dot live" />
      <text x="30" y="40" class="leg">live</text>
      <circle cx="78" cy="36" r="4.5" class="dot offline" />
      <text x="90" y="40" class="leg">offline</text>
    </g>
  </svg>
  <figcaption class="figcap">
    <span>fig.01 — federation topology</span>
    <span>aggregated at build · {federation.nodes.length} nodes</span>
  </figcaption>
</figure>
<style>
.fed-figure { padding: var(--space-4); }
.fed-graph { width: 100%; height: auto; display: block; }

.orbit { fill: none; stroke: var(--color-line-2); stroke-width: 1; stroke-dasharray: 2 7; opacity: 0.5; }

.fed-edge { fill: none; }
.fed-edge.framework { stroke: var(--color-line-2); stroke-width: 1; stroke-dasharray: 4 4; opacity: 0.75; }
.fed-edge.federation { stroke: var(--color-accent); stroke-width: 1.4; opacity: 0.85; }

.dot.live { fill: var(--color-accent); stroke: var(--color-accent); stroke-width: 1.5; }
.dot.offline { fill: var(--color-surface); stroke: var(--color-faint); stroke-width: 1.25; stroke-dasharray: 2 2; }

.halo { fill: var(--color-accent); transform-box: fill-box; transform-origin: center;
  animation: halo 3.2s var(--ease-out) infinite; }
@keyframes halo { 0% { transform: scale(0.7); opacity: 0; } 28% { opacity: 0.30; } 100% { transform: scale(2.6); opacity: 0; } }

.root-ring { fill: none; stroke: var(--color-accent); stroke-width: 1.25; opacity: 0.55; }
.root-core { fill: var(--color-accent); }
.root-pip { fill: var(--color-accent-ink); }

.fed-label { font-family: var(--font-mono); font-size: 11.5px; fill: var(--color-muted); letter-spacing: -0.02em; }
.root-label { fill: var(--color-ink); font-weight: 600; }
.legend .leg { font-family: var(--font-mono); font-size: 10.5px; fill: var(--color-faint); letter-spacing: 0.02em; }

@media (prefers-reduced-motion: reduce) { .halo { animation: none; opacity: 0.18; } }
</style>
