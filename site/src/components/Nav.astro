---
interface Props { current?: string; }
const { current = "home" } = Astro.props;
const links = [
  { id: "modules", href: "/modules", label: "Modules" },
  { id: "federation", href: "/federation", label: "Federation" },
  { id: "docs", href: "/docs", label: "Docs" },
  { id: "get-started", href: "/get-started", label: "Get started" },
  { id: "about", href: "/about", label: "About" },
];
---
<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand mono" aria-label="org-os home">~/org-os<span class="cursor" aria-hidden="true"></span></a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={["nav-link", { active: current === l.id }]}
             aria-current={current === l.id ? "page" : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
<style>
.nav {
  position: sticky; top: 0; z-index: var(--z-nav);
  background: color-mix(in srgb, var(--color-bg) 82%, transparent);
  backdrop-filter: saturate(1.4) blur(10px);
  -webkit-backdrop-filter: saturate(1.4) blur(10px);
  border-bottom: var(--border-hair) solid var(--color-line);
}
.nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 3.75rem; gap: var(--space-4); }
.brand { font-weight: 600; color: var(--color-ink); font-size: var(--text-sm); letter-spacing: -0.01em; display: inline-flex; align-items: center; }
.cursor { display: inline-block; width: 0.5em; height: 1.05em; margin-left: 0.15em; background: var(--color-accent); animation: blink 1.1s steps(1) infinite; translate: 0 0.12em; }
@keyframes blink { 50% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

.nav ul { display: flex; gap: var(--space-5); list-style: none; padding: 0;
  font-family: var(--font-mono); font-size: var(--text-sm); }
.nav-link { position: relative; color: var(--color-muted); padding: 0.35rem 0; transition: color var(--t-fast); }
.nav-link::after {
  content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 1.5px;
  background: var(--color-accent); transition: right var(--t-med);
}
.nav-link:hover { color: var(--color-ink); }
.nav-link:hover::after { right: 0; }
.nav-link.active { color: var(--color-accent); }
.nav-link.active::after { right: 0; }

@media (max-width: 640px) {
  .nav ul { gap: var(--space-4); font-size: var(--text-xs); }
  .nav-inner { flex-wrap: wrap; min-height: 0; padding-block: var(--space-3); }
}
</style>
