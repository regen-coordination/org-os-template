---
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../lib/base";
interface Props { current?: string; }
const { current = "home" } = Astro.props;
const links = [
  { id: "docs", href: "/docs", label: "Docs" },
  { id: "modules", href: "/modules", label: "Modules" },
  { id: "federation", href: "/federation", label: "Federation" },
];
---
<nav class="nav">
  <div class="container-wide nav-inner">
    <a href={withBase("/")} class="brand mono" aria-label="org-os home">~/org-os<span class="cursor" aria-hidden="true"></span></a>
    <div class="nav-right">
      <ul>
        {links.map((l) => (
          <li>
            <a href={withBase(l.href)} class:list={["nav-link", { active: current === l.id }]}
               aria-current={current === l.id ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <Search />
      <ThemeToggle />
    </div>
  </div>
</nav>
<style>
.nav {
  position: sticky; top: 0; z-index: var(--z-nav);
  background: var(--color-bg);
  border-bottom: var(--border-hair) solid var(--color-line-2);
}
.nav-right { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; }
.nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: var(--nav-height); gap: var(--space-4); }
.brand { font-weight: 600; color: var(--color-ink); font-size: var(--text-sm); letter-spacing: -0.01em; display: inline-flex; align-items: center; }
.cursor { display: inline-block; width: 0.5em; height: 1.05em; margin-left: 0.15em; background: var(--color-accent); animation: blink 1.1s steps(1) infinite; translate: 0 0.12em; }
@keyframes blink { 50% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

.nav ul { display: flex; gap: var(--space-5); list-style: none; padding: 0;
  font-family: var(--font-mono); font-size: var(--text-sm); }
/* The link fills the bar's height, so the rule under the current one sits on the bar's edge. */
.nav-link { display: inline-flex; align-items: center; min-height: var(--nav-height); color: var(--color-muted);
  border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color var(--t-fast), border-color var(--t-fast); }
.nav-link:hover { color: var(--color-ink); }
.nav-link.active { color: var(--color-ink); border-bottom-color: var(--color-accent); }

@media (max-width: 640px) {
  .nav-right { width: 100%; flex-wrap: nowrap; justify-content: space-between; gap: var(--space-3); }
  .nav ul { gap: var(--space-4); font-size: var(--text-xs); }
  .nav-inner { flex-wrap: wrap; min-height: 0; padding-top: var(--space-2); }
  .nav-link { min-height: 2.25rem; }
}
</style>
