{
  "name": "org-os-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "org-os — the agent-native org operating system. Framework website + docs + live federation.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "aggregate": "node scripts/aggregate-federation.mjs",
    "dev": "npm run aggregate && astro dev",
    "clean": "node -e \"for (const d of ['.astro','node_modules/.astro','dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "npm run clean && npm run aggregate && astro build && pagefind --site dist && npm run verify",
    "preview": "astro preview",
    "verify": "node scripts/verify-build.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.0.0",
    "@fontsource-variable/geist-mono": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "pagefind": "^1.5.2"
  }
}
