.claude/scheduled_tasks.lock

# Test gitignore fixtures
.gitignore.test

# Visual brainstorming sessions
.superpowers/

# Git worktrees (isolated workspaces)
.worktrees/

# Multica bridge local config (machine-specific path + credentials-adjacent ids)
packages/multica-bridge/config.yaml

# Symbient habitat (operator-private — see skills/symbient/SKILL.md)
# Anchored: habitats live only at the repo root. An unanchored "symbient/"
# would also match skills/symbient/ — the public framework skill directory.
/symbient/

# Graphify — commit data (graph.json, cache/, manifest.json, GRAPH_REPORT.md, cost.json),
# ignore renderings and machine-local files
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root

# Playwright test artifacts (site/)
site/test-results/

# Buzz agent lane — local read-marker state (machine-specific)
.buzz-state.json
