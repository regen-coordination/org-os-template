{
  "$id": "orgos://registry/sources",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": true,
  "x-order": [
    "id",
    "name",
    "type",
    "status",
    "last_synced"
  ],
  "x-groups": [
    {
      "label": "What it is",
      "fields": [
        "name",
        "type",
        "url"
      ]
    },
    {
      "label": "How it is read",
      "fields": [
        "sync_method",
        "feed_url",
        "status"
      ]
    }
  ],
  "properties": {
    "id": {
      "title": "Id",
      "description": "A short name, unique in this file.",
      "type": "string",
      "minLength": 1
    },
    "name": {
      "title": "Name",
      "description": "What the source is called.",
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "title": "Kind",
      "description": "What sort of source it is.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "$comment": "Instance-defined vocabulary: real instances use their own words. The examples are the framework's defaults.",
      "examples": [
        "blog",
        "podcast",
        "newsletter",
        "github",
        "forum",
        "social"
      ]
    },
    "url": {
      "title": "Link",
      "description": "Where it is.",
      "type": [
        "string",
        "null"
      ]
    },
    "feed_url": {
      "title": "Feed",
      "description": "The address of its feed, when it has one.",
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "title": "Status",
      "description": "Whether it is followed now.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "$comment": "Instance-defined vocabulary: real instances use their own words. The examples are the framework's defaults.",
      "examples": [
        "active",
        "paused",
        "archived"
      ]
    },
    "last_synced": {
      "title": "Last read",
      "description": "When it was last read.",
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sync_method": {
      "title": "Read by",
      "description": "How it is read: RSS, an API, by hand, or scraped.",
      "enum": [
        "rss",
        "api",
        "manual",
        "scrape"
      ]
    },
    "content_count": {
      "title": "Items",
      "description": "How many items have been read from it.",
      "type": [
        "number",
        "null"
      ]
    },
    "tags": {
      "title": "Tags",
      "description": "Words to find it by.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Optional fields accept null: in these YAML registries an explicitly-unset field is written as `null`, and refusing it made real entries unsavable."
}
