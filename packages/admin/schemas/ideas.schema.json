{
  "$id": "orgos://registry/ideas",
  "type": "object",
  "required": ["id"],
  "additionalProperties": true,
  "x-order": ["id", "title", "status", "submitted_by", "created", "votes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "status": { "enum": ["surfaced", "proposed", "approved", "developing", "hatched", "archived"] },
    "source": { "type": "string" },
    "submitted_by": { "type": "string" },
    "champions": { "type": "array", "items": { "type": "string" } },
    "ecosystem_gap": { "type": "string" },
    "description": { "type": "string" },
    "hatched_repo": { "type": ["string", "null"] },
    "skills_needed": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "array" },
    "compensation": { "type": "object" },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "votes": { "type": "number" },
    "comments": { "type": "array" }
  }
}
