{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "org-os/standards/daoip5-applications",
  "$comment": "Transcribed from the Applications JSON-LD Schema in DAOIP-5 at c71b94b: https://github.com/metagov/daostar/blob/c71b94ba47cd9d09bae9afb530bdb70c640e25cc/DAOIPs/daoip-5.md . Status enum is the six values the template names. extensions per https://github.com/metagov/daostar/blob/944052f1c35de24d2de7a42e62452403dc05cfad/DAOIPs/x-daoip-5.md No field with no value: null and \"\" are refused anywhere (EIP-4824: a field with no value SHOULD be removed rather than left empty or null).",
  "type": "object",
  "properties": {
    "@context": {
      "const": "http://www.daostar.org/schemas"
    },
    "name": {
      "$ref": "#/$defs/str"
    },
    "type": {
      "$ref": "#/$defs/str"
    },
    "grantPools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "GrantPool"
          },
          "name": {
            "$ref": "#/$defs/str"
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "GrantApplication"
                },
                "id": {
                  "$ref": "#/$defs/str"
                },
                "grantPoolId": {
                  "$ref": "#/$defs/str"
                },
                "grantPoolName": {
                  "$ref": "#/$defs/str"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "projectName": {
                  "$ref": "#/$defs/str"
                },
                "contentURI": {
                  "type": "string",
                  "minLength": 1,
                  "format": "uri"
                },
                "fundsAsked": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "$ref": "#/$defs/str"
                      },
                      "denomination": {
                        "$ref": "#/$defs/str"
                      }
                    },
                    "required": [
                      "amount",
                      "denomination"
                    ],
                    "additionalProperties": {
                      "$ref": "#/$defs/value"
                    }
                  }
                },
                "status": {
                  "enum": [
                    "pending",
                    "in_review",
                    "approved",
                    "funded",
                    "rejected",
                    "completed"
                  ]
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              },
              "required": [
                "type",
                "id",
                "grantPoolId",
                "grantPoolName",
                "createdAt"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/value"
        }
      }
    }
  },
  "required": [
    "@context",
    "name",
    "type",
    "grantPools"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/value"
  },
  "$defs": {
    "str": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    }
  }
}
