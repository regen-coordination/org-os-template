{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "org-os/standards/eip4824-activities",
  "$comment": "Transcribed from the Activity Log JSON-LD Schema in EIP-4824 at 7e42221: https://github.com/ethereum/ERCs/blob/7e4222187c557efb31d728ded3ac4716342164fc/ERCS/erc-4824.md No field with no value: null and \"\" are refused anywhere (EIP-4824: a field with no value SHOULD be removed rather than left empty or null).",
  "type": "object",
  "properties": {
    "@context": {
      "const": "https://www.daostar.org/schemas"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/str"
          },
          "type": {
            "const": "activity"
          },
          "proposal": {
            "type": "object",
            "properties": {
              "type": {
                "const": "proposal"
              },
              "id": {
                "$ref": "#/$defs/str"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          },
          "member": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/str"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/value"
            }
          },
          "extensions": {
            "$ref": "#/$defs/extensions"
          }
        },
        "required": [
          "id",
          "type",
          "proposal"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/value"
        }
      }
    }
  },
  "required": [
    "@context",
    "activities"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/value"
  },
  "$defs": {
    "str": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    }
  }
}
