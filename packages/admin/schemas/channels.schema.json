{
  "$id": "orgos://registry/channels",
  "type": "object",
  "required": [
    "id"
  ],
  "additionalProperties": true,
  "x-order": [
    "id",
    "platform",
    "name",
    "visibility",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "telegram",
        "discord",
        "forum",
        "email",
        "slack",
        "signal",
        "matrix"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "members",
        "core",
        "private"
      ]
    },
    "topics": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "managed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "archived",
        "migrating"
      ]
    }
  },
  "$comment": "Optional fields accept null: in these YAML registries an explicitly-unset field is written as `null`, and refusing it made real entries unsavable."
}
