{
  "$id": "orgos://registry/imports",
  "title": "Import receipts (DAO-OS L6 spec §9.6)",
  "description": "data/imports.yaml's `imports:` list: one receipt per import run that wrote anything (npm run import -- <source> <folder> --apply). Counts and reasons only: no title of a private item, no name, no private collection's id. `blobs` holds the mark of each git item it wrote (a page's git blob id, a record's digest), so a later run updates only what the Hub left as imported.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "source",
      "export",
      "at",
      "by"
    ],
    "additionalProperties": true,
    "x-order": [
      "id",
      "source",
      "export",
      "at",
      "by",
      "created",
      "updated",
      "kept",
      "not_carried",
      "blobs"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^imp_[0-9a-f]+$"
      },
      "source": {
        "enum": [
          "notion",
          "fileverse"
        ]
      },
      "export": {
        "type": "string",
        "minLength": 1
      },
      "at": {
        "type": "string",
        "minLength": 1
      },
      "by": {
        "type": "string",
        "minLength": 1
      },
      "created": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "collections": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "updated": {
        "type": "integer",
        "minimum": 0
      },
      "kept": {
        "type": "integer",
        "minimum": 0
      },
      "not_carried": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "what",
            "why"
          ],
          "properties": {
            "what": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        }
      },
      "blobs": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
