{
  "name": "@org-os/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build app",
    "start": "npm run build && tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "dev:app": "vite app",
    "e2e": "npm run build && tsx tests/e2e/golden.mts && tsx tests/e2e/claim.mts && tsx tests/e2e/proposals.mts && tsx tests/e2e/signin.mts && tsx tests/e2e/workspace.mts && tsx tests/e2e/compose.mts",
    "e2e:parts": "npm run build && tsx tests/e2e/parts.mts",
    "e2e:reflow": "npm run build && tsx tests/e2e/reflow.mts",
    "e2e:routes": "npm run build && tsx tests/e2e/routes.mts",
    "e2e:a11y": "npm run build && tsx tests/e2e/a11y.mts",
    "e2e:keys": "npm run build && tsx tests/e2e/keys.mts",
    "house:backup": "tsx scripts/house-backup.ts backup",
    "house:backup:key": "tsx scripts/house-backup.ts key",
    "house:backup:keypair": "tsx scripts/house-backup.ts keypair",
    "house:restore": "tsx scripts/house-backup.ts restore",
    "house:roles": "tsx scripts/house-roles.ts",
    "house:session-key": "tsx scripts/house-session-key.ts",
    "import": "tsx scripts/import.ts",
    "check:shelf": "node --import tsx scripts/check-shelf.mts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@noble/curves": "2.4.0",
    "@tanstack/react-query": "^5.60.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.0",
    "hono": "^4.6.0",
    "lucide-react": "1.63.0",
    "markdown-it": "14.3.3",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "wouter": "^3.3.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "4.14.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
