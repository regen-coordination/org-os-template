{
  "name": "@org-os/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build app",
    "start": "npm run build && tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "dev:app": "vite app",
    "e2e": "npm run build && tsx tests/e2e/golden.mts && tsx tests/e2e/claim.mts && tsx tests/e2e/proposals.mts && tsx tests/e2e/signin.mts",
    "e2e:parts": "npm run build && tsx tests/e2e/parts.mts",
    "e2e:reflow": "npm run build && tsx tests/e2e/reflow.mts",
    "e2e:routes": "npm run build && tsx tests/e2e/routes.mts",
    "e2e:a11y": "npm run build && tsx tests/e2e/a11y.mts",
    "e2e:keys": "npm run build && tsx tests/e2e/keys.mts",
    "house:backup": "tsx scripts/house-backup.ts backup",
    "house:backup:key": "tsx scripts/house-backup.ts key",
    "house:restore": "tsx scripts/house-backup.ts restore"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@noble/curves": "2.4.0",
    "@tanstack/react-query": "^5.60.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.0",
    "hono": "^4.6.0",
    "lucide-react": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "wouter": "^3.3.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "4.14.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
