    ],
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "url": {
        "type": [
          "string",
          "null"
        ]
      },
      "feed_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "last_synced": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "sync_method": {
        "enum": [
          "rss",
          "api",
          "manual",
          "scrape"
        ]
      },
      "content_count": {
        "type": [
          "number",
          "null"
        ]
      },
      "tags": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    }
  }
}
