          "null"
        ],
        "minLength": 1
      },
      "type": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "lead": {
        "type": [
          "string",
          "null"
        ]
      },
      "contributors": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "started": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "target_completion": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "description": {
        "type": [
