  },
  "members": {
    "$id": "orgos://registry/members",
    "type": "object",
    "required": [
      "id"
    ],
    "additionalProperties": true,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "kind": {
        "enum": [
          "person",
          "agent",
          "organization",
          "role",
          null
        ]
      },
      "role": {
        "type": [
          "string",
          "null"
        ]
      },
      "layer": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "status": {
        "enum": [
          "active",
          "inactive",
          "alumni"
        ]
      },
      "joined": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "left": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "skills": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      },
      "email": {
        "type": [
          "string",
          "null"
        ]
      },
      "handles": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "git": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}:[-.%a-zA-Z0-9]{1,128}$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}:[-.%a-zA-Z0-9]{1,128}$"
                }
              }
            ]
          }
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "affiliations": {
        "type": [
          "array",
          "null"
        ]
      }
    }
  },
  "funding-opportunities": {
