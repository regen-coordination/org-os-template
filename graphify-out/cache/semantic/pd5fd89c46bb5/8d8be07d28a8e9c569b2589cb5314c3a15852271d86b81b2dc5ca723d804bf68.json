{"nodes": [{"id": "integrations_opal_docs_architecture_system_architecture", "label": "OPAL Integration System Architecture", "file_type": "document", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "integrations_opal_docs_architecture_opal", "label": "OPAL (AI Knowledge Garden)", "file_type": "concept", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "System Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OPAL performs AI entity extraction (people, orgs, patterns) with confidence scoring locally, keeping heavy AI processing out of the bridge; it complements KOI, which handles network-wide federation."}, {"id": "integrations_opal_docs_architecture_opal_bridge", "label": "OPAL Bridge", "file_type": "concept", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "System Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bridge exists to translate between OPAL's AI-extracted entities and org-os structured YAML registries, deliberately routing all extractions through staging and human review before they become trusted storage. Total pipeline latency is bottlenecked by human review by design."}, {"id": "integrations_opal_docs_architecture_entitymapper", "label": "EntityMapper", "file_type": "code", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Integration Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "integrations_opal_docs_architecture_gitsync", "label": "GitSync", "file_type": "code", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Integration Layer", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "integrations_opal_docs_architecture_meetingpipeline", "label": "MeetingPipeline", "file_type": "code", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Meeting Pipeline", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "integrations_opal_docs_architecture_human_review_queue", "label": "Human Review Queue", "file_type": "rationale", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Review Queue Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI extraction accuracy is only 80-95% depending on entity type, so a confidence-based decision matrix gates auto-approval: high-confidence people/orgs may auto-approve, but decisions and action items always require explicit human review (3 reviewers) because they trigger organizational consequences. Trade-off accepted: review is the pipeline latency bottleneck (1-48 hrs) in exchange for trusted storage."}, {"id": "integrations_opal_docs_architecture_solo_mode", "label": "Solo Mode", "file_type": "concept", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Two-Mode Operation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-user mode: author approves own extractions and commits directly to main, chosen for individual operators and testing where PR overhead adds no value."}, {"id": "integrations_opal_docs_architecture_commons_mode", "label": "Commons Mode", "file_type": "concept", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Two-Mode Operation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Team mode: extractions flow through PR-based review with optional voting so shared knowledge requires collective approval before merge \u2014 governance over shared truth."}, {"id": "integrations_opal_docs_architecture_koi", "label": "KOI (Distributed Knowledge Network)", "file_type": "concept", "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "Data Flow: Meeting to Knowledge", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KOI broadcast is optional and consent-based: local knowledge only leaves the org after human approval, keeping OPAL usable standalone without network sharing."}], "edges": [{"source": "integrations_opal_docs_architecture_system_architecture", "target": "integrations_opal_docs_api_reference_api_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "See Also", "weight": 1.0}, {"source": "integrations_opal_docs_architecture_system_architecture", "target": "integrations_opal_docs_setup_guide_setup_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "See Also", "weight": 1.0}, {"source": "integrations_opal_docs_architecture_system_architecture", "target": "integrations_opal_docs_workflows_workflows", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "See Also", "weight": 1.0}, {"source": "integrations_opal_docs_architecture_system_architecture", "target": "integrations_opal_docs_faq_faq", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "See Also", "weight": 1.0}, {"source": "integrations_opal_docs_architecture_opal_bridge", "target": "integrations_opal_docs_architecture_opal", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "integrations/opal/docs/ARCHITECTURE.md", "source_location": "System Overview data flow", "weight": 1.0}, {"source": "integrations_opal_docs_architecture_opal_bridge", "targ