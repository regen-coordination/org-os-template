{"nodes": [{"id": "packages_koi_opal_bridge_readme_koi_opal_bridge", "label": "KOI/OPAL Bridge", "file_type": "code", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integration layer connecting two complementary knowledge systems: OPAL (AI librarian, org-level gardens, human-in-the-loop) and KOI (protocol, network-scale RID-based graphs). Bridged because neither alone gives both local AI extraction quality and global federation reach."}, {"id": "packages_koi_opal_bridge_readme_opal", "label": "OPAL (AI Librarian)", "file_type": "concept", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organization-level AI-powered knowledge garden: /process extracts entities from meetings/documents, /review keeps a human in the loop, /ask answers questions; strength is AI extraction with human curation."}, {"id": "packages_koi_opal_bridge_readme_rid", "label": "RID (Resource Identifier)", "file_type": "concept", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typed identifiers (rid:orgos:person, rid:orgos:pattern, rid:orgos:meeting, ...) that map OPAL entities and org-os data registries onto the KOI network, enabling attribution and consent-based sharing."}, {"id": "packages_koi_opal_bridge_readme_cosmo_local_knowledge", "label": "Cosmo-Local Knowledge", "file_type": "rationale", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design intent of the KOI/OPAL integration: local AI-powered knowledge gardens that federate into global knowledge networks \u2014 knowledge is curated locally with human review but shared network-wide via RIDs."}, {"id": "packages_koi_opal_bridge_readme_copyfair", "label": "CopyFair Mechanism", "file_type": "rationale", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both OPAL (git history + extraction provenance) and KOI (RID-based attribution, consent-based sharing) track attribution; together they enable CopyFair \u2014 contributions tracked, attribution preserved, value flows to contributors."}, {"id": "packages_koi_opal_bridge_readme_regen_agency", "label": "Regen Agency", "file_type": "concept", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_koi_opal_bridge_readme_agent_dojo", "label": "Agent Dojo", "file_type": "concept", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent training concept from Regen Agency: well-maintained knowledge gardens (via OPAL/KOI) train better agents; gardens are the foundation of the training pipeline."}, {"id": "packages_koi_opal_bridge_readme_human_in_the_loop_review", "label": "Human-in-the-Loop Review", "file_type": "rationale", "source_file": "packages/koi-opal-bridge/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality gate in every workflow: OPAL-extracted entities must pass /review human approval before being broadcast as RIDs to the KOI network \u2014 entities not appearing in KOI is diagnosed first by checking whether /review approval happened."}], "edges": [{"source": "packages_koi_opal_bridge_readme_koi_opal_bridge", "target": "packages_koi_bridge_readme_koi_bridge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "so