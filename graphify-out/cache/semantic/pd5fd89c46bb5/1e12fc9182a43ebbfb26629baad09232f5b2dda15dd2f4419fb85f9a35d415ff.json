{"nodes": [{"id": "agents_agent_guide", "label": "AGENTS.md \u2014 Agent Operating Guide", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_session_startup_sequence", "label": "Deterministic Session Startup Sequence", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fixed read-order of core files at every session start guarantees memory continuity and prevents context loss between agent sessions; success indicator is 'no context loss between sessions'."}, {"id": "agents_memory_system", "label": "Memory System (long-term index + daily logs)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split memory into a curated long-term index (MEMORY.md), append-only daily logs (memory/YYYY-MM-DD.md), and ground-truth data (data/*.yaml) so session memory survives agent context resets; append-never-overwrite preserves traceability via source_refs."}, {"id": "agents_subagent_delegation_patterns", "label": "Subagent Delegation Patterns (swarm, pipeline, parallel research)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost-tiered model selection (Kimi-2.5/Big-Pickle for cheap extraction, Claude-Sonnet for quality review, GPT-4 for high-stakes approval) makes multi-agent work cost-effective; patterns are data swarms, three-tier review pipelines, and parallel research."}, {"id": "agents_autopoietic_coordination", "label": "Autopoietic Agent Coordination (six principles)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent ecosystem is designed as a living emergent system rather than a rigid hierarchy: alignment without control, emergence over planning, self-organization, healthy role overlap, and conflict treated as design signal \u2014 because bottom-up patterns propagate better than top-down prescriptions."}, {"id": "agents_safety_policy", "label": "Safety Policy (autonomous vs approval boundaries)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External communication, on-chain transactions, publishing, identity-file edits, and financial actions require operator approval; internal memory/schema work is autonomous. Design intent: 'When in doubt: draft and present, don't execute.' A two-tier operator/council pattern adds a second approval layer for major decisions."}, {"id": "agents_knowledge_commons", "label": "Regen Agency Knowledge Commons", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Section 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "org-os acts as upstream reference: template changes flow downstream to forks, working patterns from nodes are extracted back into standards, and nodes sync versions monthly."}, {"id": "agents_agent_dojo", "label": "Agent Dojo (distributed agent learning network)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Section 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knowledge is structured for both human and agent consumption with semantic (not hierarchical) routing, so agents are first-class participants who learn continuously from operational experience; org-os defines the structural patterns, sync protocols, and semantic standards."}], "edges": [{"source": "agents_agent_guide", "target