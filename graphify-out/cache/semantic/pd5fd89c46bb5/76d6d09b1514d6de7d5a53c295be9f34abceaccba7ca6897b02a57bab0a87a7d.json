{"nodes": [{"id": "_opencode_skills_org_os_init_skill_org_os_init_skill", "label": "Org-OS-Init Session Lifecycle Skill", "file_type": "document", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_opencode_skills_org_os_init_skill_session_lifecycle", "label": "OPEN \u2192 PLAN \u2192 EXECUTE \u2192 CLOSE Session Lifecycle", "file_type": "concept", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design intent: the agent arrives already aware and oriented \u2014 a living system showing current state, not a blank slate. Every session should feel sharp, effortless, purposeful."}, {"id": "_opencode_skills_org_os_init_skill_initialization_dashboard", "label": "Initialization Dashboard (Phase 1: OPEN)", "file_type": "concept", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": "Phase 1: OPEN", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard doubles as a launchpad ('Or:' line signals the operator can go anywhere); on malformed script output it degrades gracefully to direct file reads \u2014 never show an error to the operator."}, {"id": "_opencode_skills_org_os_init_skill_auto_sync_bookends", "label": "Auto-Sync Session Bookends", "file_type": "rationale", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": "Session Bookends: Auto-Sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git pull before load, push after close, so the operator never has to remember syncing; on failure continue silently with local state \u2014 never block the session on a sync failure."}, {"id": "_opencode_skills_org_os_init_skill_close_protocol", "label": "Session Close Protocol (Phase 4: CLOSE)", "file_type": "concept", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": "Phase 4: CLOSE", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commit + push is 'the whole point of close'; the memory write is never skipped because it is the thread that connects sessions."}, {"id": "_opencode_skills_org_os_init_skill_visual_language", "label": "Dashboard Visual Language (box-drawing, status glyphs)", "file_type": "concept", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": "Visual Language", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unicode box-drawing and block elements chosen because they render in all modern terminals and agent tools; factual only \u2014 no mission quotes or taglines."}, {"id": "_opencode_skills_org_os_init_skill_egregore", "label": "Egregore Shared AI Memory", "file_type": "concept", "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_opencode_skills_org_os_init_skill_org_os_init_skill", "target": "_opencode_skills_org_os_init_skill_session_lifecycle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_skills_org_os_init_skill_org_os_init_skill", "target": "_opencode_skills_org_os_init_skill_initialization_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/org-os-init/SKILL.md", "source_location": "Phase 1", "weight": 1.0}, {"source": "_opencode_skills_org_os_init_skill_org_os_init_skill", "target": "_opencode_skills_org_os_init_skill_close_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/skills/org-os-init/SKILL.md