# The hosted Hub's settings (L9 spec §5.1): every variable `readHostedConfig` reads, and nothing else. Placeholder values
# only. Unset lines take the default shown in the comment above them.

# Hosted mode. Set in the image (1).
ORG_OS_HOSTED=1

# The members' side: https:// and its host, no path. Required.
ORG_OS_PUBLIC_ORIGIN=https://hub.example.org

# The portal's origin (the public site), a host of its own. Unset: the portal is built, not served. The three
# ORG_OS_PORTAL_* settings were ORG_OS_DOOR_* until 0.6.2; the old names are read, with a warning, until org-os 0.7.
ORG_OS_PORTAL_ORIGIN=https://example.org

# Where the server listens inside the container (0.0.0.0, 4680). A platform that assigns the port sets PORT itself.
ORG_OS_BIND=0.0.0.0
PORT=4680

# on: the client's address is read from X-Real-IP, which the proxy in front sets, replacing any value a client sent.
# A container platform's proxy sets the X-Forwarded-* headers (and, on the reference platform, X-Real-IP: check it on
# staging, RAILWAY.md). on or off; any other value stops the start.
ORG_OS_TRUST_PROXY=on

# The portal's releases (/srv/portal) and its refresh (1h; off for none).
ORG_OS_PORTAL_DIR=/srv/portal
ORG_OS_PORTAL_EVERY=1h

# on: push the trunk after the Hub's commits. off while the Hub only reads its instance (house amendment item 6):
# a read-only deploy key cannot push. on or off; any other value stops the start.
ORG_OS_PUSH=off

# While HOUSE_INSTANCE_WRITES is off, the Hub takes its instance's new commits from the remote: at start, then every
# 15m (fetch, then fast-forward only). A history that diverged stops it until the Hub starts again, and the Sources page
# says so. A time such as 15m, or off for none.
ORG_OS_REFRESH_EVERY=15m

# off (the hosted default): the Hub writes nothing to its instance. Every write route answers "read-only until writes
# are turned on"; no commit, no push whatever ORG_OS_PUSH says, no reconcile at start. Sign-in still works. on is
# refused while this org-os still lists write defects to fix first. on or off; any other value stops the start.
HOUSE_INSTANCE_WRITES=off

# The private store and its backups (/srv/private, /srv/backups, every 6h, keep 14), sealed to a maintainer's
# X25519 public key (/run/secrets/backup.pub). The private key never comes here.
ORG_OS_PRIVATE_DIR=/srv/private
ORG_OS_BACKUP_DIR=/srv/backups
ORG_OS_BACKUP_EVERY=6h
ORG_OS_BACKUP_KEEP=14
ORG_OS_BACKUP_PUBLIC_KEY_FILE=/run/secrets/backup.pub

# Jobs, layouts, drafts and the server's pid file (/srv/state).
ORG_OS_ADMIN_HOME=/srv/state

# confirmed: the remote is private, for a forge the Hub cannot ask (rule 4). Unset otherwise.
ORG_OS_REMOTE_PRIVATE=

# Per-chain RPC: <CAIP-2 chain>=<https URL>, comma-separated. Unset: the public defaults.
ORG_OS_RPC=

# How git reaches the remote: the deploy key and the known hosts, read-only files only the Hub's user can read.
GIT_SSH_COMMAND=ssh -i /run/secrets/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/run/secrets/known_hosts

# Sign-in with an emailed link. Leave all of these unset and the Hub starts without it; set one and the five required
# ones must all be set (only the cookie domain is optional). Secrets go in the platform's secret store, never here.
# The pepper keys the email fingerprints the Hub looks people up by (it never stores an address): 32 bytes or more as
# hex (openssl rand -hex 32), the same value the records side used to compute the keys.
HOUSE_EMAIL_PEPPER=
# The Ed25519 private key that signs the session cookie, as a JWK on one line (npm run house:session-key -- new).
HOUSE_SESSION_PRIVATE_JWK=
# The session cookie's name: one per environment, so a staging session is never read as production's. Not __Host-.
SESSION_COOKIE_NAME=org_session_dev
# Optional: the domain the cookie is sent to, so the org's other sites read the same sign-in. The Hub's host must be
# inside it. Unset: the cookie stays on the Hub's host.
SESSION_COOKIE_DOMAIN=example.org
# The mail provider's API key, and the sender: an address on its verified domain, or a name and <address>.
RESEND_API_KEY=
MAIL_FROM=
