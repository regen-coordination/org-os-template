{
  "name": "organizational-os-template",
  "description": "GitHub-based operational workspace template with EIP-4824 compliance",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/organizational-os/organizational-os-template.git"
  },
  "scripts": {
    "clone:repos": "node scripts/clone-linked-repos.mjs",
    "index:repos": "node scripts/index-linked-repos.mjs",
    "bootstrap:local": "npm run clone:repos && npm install",
    "setup": "node scripts/setup-org-os.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "sync:commands": "node scripts/sync-commands.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:skills:berd": "node scripts/sync-skills-berd.mjs",
    "generate:schemas": "node scripts/generate-all-schemas.mjs",
    "validate:schemas": "node scripts/validate-identity.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "analyze:instances": "node scripts/analyze-instances.mjs",
    "doctor": "node scripts/doctor.mjs",
    "version:update": "node scripts/update-version.mjs",
    "migrate": "node scripts/migrate.mjs",
    "vault:snapshot": "node scripts/vault-snapshot.mjs",
    "vault:audit": "node scripts/vault-audit.mjs",
    "knowledge:compile": "node scripts/compile-knowledge.mjs",
    "knowledge:index": "node scripts/index-linked-repos.mjs",
    "knowledge:lint": "node scripts/lint-knowledge.mjs",
    "knowledge:normalize": "node scripts/normalize-kb-frontmatter.mjs",
    "knowledge:update-index": "node scripts/update-knowledge-index.mjs",
    "compile:knowledge": "node scripts/compile-knowledge.mjs && node scripts/update-knowledge-index.mjs",
    "lint:knowledge": "node scripts/lint-knowledge.mjs",
    "knowledge": "npm run compile:knowledge && npm run lint:knowledge",
    "graph:status": "node scripts/graph-status.mjs --format=markdown",
    "graph:gaps": "node scripts/graph-gaps.mjs",
    "graph:update": "command -v graphify >/dev/null 2>&1 && graphify . --update || echo 'graph: CLI not installed — see docs/integrations/graphify.md'",
    "check:divergence": "node scripts/check-divergence.mjs",
    "selftest": "node scripts/selftest.mjs",
    "version:check": "node scripts/update-version.mjs --check",
    "install:hooks": "node scripts/install-hooks.mjs",
    "test:multica-bridge": "npm test --prefix packages/multica-bridge",
    "test:cloudflare-os-integration": "npm test --prefix packages/cloudflare-os-integration",
    "test:admin": "npm test --prefix packages/admin",
    "generate:skills": "node scripts/generate-skills.mjs",
    "generate:quilt": "node scripts/generate-quilt.mjs",
    "sync:packages": "node scripts/sync-packages.mjs",
    "render:templates": "node scripts/render-templates.mjs",
    "clone:framework": "node scripts/clone-framework.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "docs": "npx quartz build --serve -d docs",
    "check": "node scripts/graph-status.mjs --test && node scripts/graph-gaps.mjs --test && tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "initialize": "node scripts/initialize.mjs",
    "initialize:markdown": "node scripts/initialize.mjs --format=markdown",
    "page": "node scripts/page-shim.mjs",
    "paperclip": "cd packages/paperclip-agents-app && npm run dev",
    "paperclip:server": "cd packages/paperclip-agents-app && npm run dev:server",
    "paperclip:build": "cd packages/paperclip-agents-app && npm run build:ui",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "generate:dashboard": "node packages/dashboard/generate.mjs",
    "build:site": "cd repos/refi-bcn-knowledge && npx quartz build",
    "serve:site": "cd repos/refi-bcn-knowledge && npx quartz build --serve",
    "admin": "npm --prefix packages/admin run start",
    "admin:dev": "npm --prefix packages/admin run dev"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "organizational-os",
    "eip-4824",
    "dao",
    "operational-workspace",
    "github",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@notionhq/client": "^3.1.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
