# .env.example — ReFi BCN OS environment configuration
# Copy to .env and fill in values: cp .env.example .env

# Notion API key (for script-based Notion access)
# Get yours: https://www.notion.so/profile/integrations → create integration → copy key
# Then share your Notion databases with the integration
# Optional if using Claude Code/Cursor (MCP handles auth automatically)
NOTION_API_KEY=

# Buzz agent lane (local dev relay only — see docs/superpowers/specs/2026-08-28-buzz-integration-design.md)
# Mint the keypair with the pinned `buzz` binary (packages/buzz-integration/VERIFIED.md); npub goes in TOOLS.md
# BUZZ_RELAY_URL is an HTTP endpoint (POST /query), not a websocket.
# BUZZ_CHANNEL must be a UUID, not a channel name — resolve it with `buzz channels list`.
# BUZZ_PRIVATE_KEY accepts either 64-char hex or nsec1... bech32.
# BUZZ_CLI_BIN only needed if the `buzz` binary isn't on PATH.
# Note: quote any value containing "#" (e.g. BUZZ_RELAY_URL="http://host/path#frag") — the
# parser treats an unquoted "#" as a comment marker even without preceding whitespace.
BUZZ_RELAY_URL=http://localhost:3000
BUZZ_CHANNEL=
BUZZ_PRIVATE_KEY=
BUZZ_CLI_BIN=
